generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FAQ {
  id          String   @id
  title       String
  description String
  pagename    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model PricingTier {
  id         String   @id
  minAmount  Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  currency   String   @default("USD")
  multiplier Float
  desc       String   @default("")
  title      String   @default("")

  @@unique([minAmount, currency])
}

model Recharge {
  id                String         @id
  userId            String
  amount            Float
  createdAt         DateTime       @default(now())
  credits           Int
  currency          String         @default("USD")
  status            RechargeStatus @default(PENDING)
  updatedAt         DateTime
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  razorpaySignature String?
  User              User           @relation(fields: [userId], references: [id])
}

model SeoProps {
  id          String   @id
  title       String
  description String
  keywords    String
  image       String
  pagename    String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model Tool {
  id          String   @id
  name        String
  description String
  image       String
  link        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  isEnabled   Boolean  @default(true)
}

model User {
  id              String     @id
  firstName       String
  lastName        String
  email           String     @unique
  phoneNumber     String?
  hashed_password String?
  signInType      SignInType @default(NORMAL)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime
  credits         Int        @default(0)
  Recharge        Recharge[]
}

enum RechargeStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SignInType {
  GOOGLE
  NORMAL
}
